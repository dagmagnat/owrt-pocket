  3)
   for svc in openvpn sing-box xray tailscale; do [ ! -x "/etc/init.d/$svc" ] || say "$svc"; done
   ask 'Service (0 back):' || return; svc=$ANSWER
   case "$svc" in openvpn|sing-box|xray|tailscale) :;; *) return;; esac
   [ -x "/etc/init.d/$svc" ] && /etc/init.d/"$svc" running || { bad 'Service not running'; return; }
   yes || return
