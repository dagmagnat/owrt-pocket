   6) repair;; 7) wan_setup;; 8) packages;;
   9)
    say "$(t '1 Язык | 2 Пароль root | 3 Подтвердить | 4 Откатить | 0 Назад' '1 Language | 2 Root password | 3 Confirm | 4 Roll back | 0 Back')"
    ask '>' || break
    case "$ANSWER" in 1) language;; 2) say "$(t 'Пароль не откатывается автоматически.' 'Password changes have no automatic rollback.')"; yes && passwd root;; 3) confirm;; 4) yes && rollback "$(pending_id)";; esac;;
