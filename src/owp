   case "$n" in wan|wan6|lan|loopback) return;; esac
   case "$(get network.$n.proto)" in wireguard|pptp|l2tp) :;; *) bad 'Only dedicated VPN tunnels supported'; return;; esac
   say "$(t '1 Включить при загрузке | 2 Отключить | 0 Назад' '1 Enable on boot | 2 Disable | 0 Back')"
   ask '>' || return
   case "$ANSWER" in 1) auto=1;; 2) auto=0;; *) return;; esac
   begin || return; stage set "network.$n.auto=$auto" || return
   if [ "$auto" = 0 ]; then printf '%s\n' "$n" > "$TX/down-interface"; fi
   apply;;
 esac
