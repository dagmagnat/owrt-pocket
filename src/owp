if [ "${OWP_SOURCE_ONLY:-0}" = 1 ]; then return 0; fi
case "${1:-}" in demo|--demo) demo; exit;; --version) printf '%s\n' "$VERSION"; exit;; esac
need_root
[ -f /etc/openwrt_release ] || { bad 'OpenWrt required (try: owp demo)'; exit 1; }
mkdir -p "$BASE/transactions"
case "${1:-}" in
 _apply) worker "${2:-}"; exit;;
 _watch) sleep 120; rollback "${2:-}"; exit;;
 _boot)
  id=$(pending_id)
  if [ -n "$id" ] && load_tx "$id"; then
   if [ "$(cat "$TX/result" 2>/dev/null)" = confirmed ]; then rm -f "$BASE/pending"; else rollback "$id" boot; fi
  fi
  exit;;
 _vpn)
  case "${2:-}" in openvpn|sing-box|xray|tailscale) :;; *) exit 1;; esac
  # Start recovery timer before stopping; survives a dropped SSH session.
  (sleep 120; /etc/init.d/"$2" start) &
  /etc/init.d/"$2" stop; wait; exit;;
esac
# Confirmation and rollback use the transaction's atomic claim, and must also
# work from a second SSH session while the original menu is still open.
case "${1:-}" in
 confirm) confirm; exit;;
 rollback) yes && rollback "$(pending_id)"; exit;;
 repeater-status) repeater_status; exit;;
esac
# One foreground session; recover lock after a disconnected terminal.
LOCK=/var/lock/owrt-pocket
if ! mkdir "$LOCK" 2>/dev/null; then
 pid=$(cat "$LOCK/pid" 2>/dev/null || :)
 case "$pid" in ''|*[!0-9]*) bad 'Busy lock'; exit 1;; esac
 if kill -0 "$pid" 2>/dev/null; then bad 'Another owp session is open'; exit 1; fi
 rm -f "$LOCK/pid"; rmdir "$LOCK" 2>/dev/null && mkdir "$LOCK" || exit 1
fi
printf '%s\n' "$$" > "$LOCK/pid"
cleanup() { stty echo 2>/dev/null || :; rm -f "$LOCK/pid"; rmdir "$LOCK" 2>/dev/null || :; }
trap cleanup EXIT
trap 'exit 130' INT TERM HUP
case "${1:-}" in
 '') main;; status) status;; clients) clients;; interfaces) interfaces;; doctor) doctor;; scan) lan_scan;;
 internet) wan_setup;; repeater) repeater_setup;; repeater-status) repeater_status;; lan) lan_setup;;
 *) printf 'owp [status|clients|interfaces|doctor|scan|internet|repeater|repeater-status|lan|confirm|rollback|demo|--version]\n'; exit 1;;
esac
