repeater_status() {
 if [ -r "$BASE/repeater-result" ]; then cat "$BASE/repeater-result"; else say "$(t 'Проверок повторителя ещё нет.' 'No repeater checks yet.')"; fi
 ubus call network.interface.owp_wwan status 2>/dev/null || :
}
repeater_verify() {
 printf '%s\n' "$(t 'Проверка подключения повторителя…' 'Checking repeater connection…')" > "$BASE/repeater-result"
 attempt=0
 while [ "$attempt" -lt 20 ]; do
  # The watchdog may have restored settings while netifd was reloading.
  [ -f "$BASE/pending" ] && [ ! -d "$TX/claim" ] || return 1
  uplink=$(ubus call network.interface.owp_wwan status 2>/dev/null) || uplink='{}'
  upstream=$(printf '%s' "$uplink" | jsonfilter -e '@["ipv4-address"][0].address')
  upstream_mask=$(printf '%s' "$uplink" | jsonfilter -e '@["ipv4-address"][0].mask')
  up=$(printf '%s' "$uplink" | jsonfilter -e '@.up')
  if [ "$up" = true ] && ipv4 "$upstream" && prefix_valid "$upstream_mask"; then
   for iface in $(sections network interface); do
    case "$iface" in owp_wwan|loopback) continue;; esac
    net=$(ubus call "network.interface.$iface" status 2>/dev/null) || continue
    count_addr=0
    while :; do
     other=$(printf '%s' "$net" | jsonfilter -e "@[\"ipv4-address\"][$count_addr].address")
     bits=$(printf '%s' "$net" | jsonfilter -e "@[\"ipv4-address\"][$count_addr].mask")
     [ -n "$other" ] || break
     if overlap "$upstream" "$upstream_mask" "$other" "$bits"; then
      {
       printf '%s\n' "$(t 'КОНФЛИКТ ПОДСЕТЕЙ. Будет выполнен откат.' 'SUBNET CONFLICT. Rolling back.')"
       printf 'Upstream: %s/%s; %s: %s/%s\n' "$upstream" "$upstream_mask" "$iface" "$other" "$bits"
       t 'Запустите owp repeater ещё раз и выберите другой LAN IP; если конфликт с WAN — отсоедините кабель WAN.' 'Run owp repeater again and choose another LAN IP; for WAN overlap unplug the WAN cable.'
      } > "$BASE/repeater-result"
      return 1
     fi
     count_addr=$((count_addr + 1))
    done
   done
   printf '%s\n' "$(t 'Повторитель получил IPv4; пересечений подсетей не найдено. Проверьте интернет и выполните owp confirm.' 'Repeater obtained IPv4; no subnet overlaps found. Check internet and run owp confirm.')" > "$BASE/repeater-result"
   return 0
  fi
  attempt=$((attempt + 1)); sleep 2
 done
 printf '%s\n' "$(t 'Нет DHCP-адреса от основного роутера. Проверьте пароль/сигнал/поддержку AP+STA. Выполняется откат.' 'No upstream DHCP address. Check password/signal/AP+STA support. Rolling back.')" > "$BASE/repeater-result"
 return 1
}
repeater_stage() {
 # All object names are reserved for this tool; never overwrite user objects.
 for spec in network.owp_wwan wireless.owp_sta firewall.owp_uplink firewall.owp_forward; do
  if [ -n "$(get "$spec")" ] && [ "$(get "$spec.owp_managed")" != 1 ]; then bad "Reserved name already used: $spec"; return 1; fi
 done
 for n in $(sections firewall zone); do
  if [ "$(get firewall.$n.name)" = owp_uplink ] && [ "$n" != owp_uplink ]; then bad 'Firewall zone name owp_uplink already used'; return 1; fi
 done
 begin || return 1
 if [ -n "$LAN_ADDR" ]; then lan_settings || return 1; fi
 stage set network.owp_wwan=interface &&
 stage set network.owp_wwan.owp_managed=1 &&
 stage set network.owp_wwan.proto=dhcp &&
 stage set network.owp_wwan.auto=1 &&
 stage set network.owp_wwan.metric=500 &&
 stage set wireless.owp_sta=wifi-iface &&
 stage set wireless.owp_sta.owp_managed=1 &&
 stage set "wireless.owp_sta.device=$RADIO" &&
 stage set wireless.owp_sta.mode=sta &&
 stage set wireless.owp_sta.network=owp_wwan &&
 stage set wireless.owp_sta.disabled=0 &&
 stage set "wireless.owp_sta.ssid=$UP_SSID" &&
 stage set "wireless.owp_sta.bssid=$BSSID" &&
 stage set "wireless.owp_sta.encryption=$ENC" &&
 stage set "wireless.owp_sta.key=$UP_KEY" &&
 stage set "wireless.$RADIO.disabled=0" &&
 stage set "wireless.$RADIO.channel=$CHANNEL" &&
 stage set "wireless.$AP.disabled=0" &&
 stage set firewall.owp_uplink=zone &&
 stage set firewall.owp_uplink.owp_managed=1 &&
 stage set firewall.owp_uplink.name=owp_uplink &&
 stage set firewall.owp_uplink.network=owp_wwan &&
 stage set firewall.owp_uplink.input=REJECT &&
 stage set firewall.owp_uplink.output=ACCEPT &&
 stage set firewall.owp_uplink.forward=REJECT &&
 stage set firewall.owp_uplink.masq=1 &&
 stage set firewall.owp_uplink.mtu_fix=1 &&
 stage set firewall.owp_forward=forwarding &&
 stage set firewall.owp_forward.owp_managed=1 &&
 stage set firewall.owp_forward.src=lan &&
 stage set firewall.owp_forward.dest=owp_uplink || return 1
 touch "$TX/repeater"
}
repeater_setup() {
 [ ! -r "$BASE/repeater-result" ] || cat "$BASE/repeater-result"
 [ -z "$(pending_id)" ] || { bad 'Resolve pending change first'; return; }
 [ "$(get network.lan.proto)" = static ] && [ "$(get dhcp.lan.interface)" = lan ] && [ "$(get dhcp.lan.ignore)" != 1 ] && [ -z "$(get network.lan.gateway)" ] || { bad 'Static LAN with active local DHCP and no LAN default gateway required'; return; }
 lan_zone=
 for n in $(sections firewall zone); do
  [ "$(get firewall.$n.name)" = lan ] || continue
  case " $(get firewall.$n.network) " in *' lan '*) lan_zone=$n;; esac
 done
 [ -n "$lan_zone" ] && [ "$(get firewall.$lan_zone.input)" = ACCEPT ] || { bad 'Existing trusted LAN firewall zone required'; return; }
 say "$(t 'ПОВТОРИТЕЛЬ IPv4 (AP+STA/NAT). Сохранится отдельная LAN и пароль вашей точки доступа.' 'IPv4 REPEATER (AP+STA/NAT). Your separate LAN and AP password are preserved.')"
 say "$(t 'На одном радио скорость снижается; при пропадании основной сети ваша AP тоже может пропасть. Для восстановления нужен кабель.' 'Shared-radio throughput is reduced; loss of upstream may also stop your AP. Keep Ethernet recovery access.')"
 ubus list iwinfo 2>/dev/null | grep -qx iwinfo || { bad 'Install rpcd-mod-iwinfo for Wi-Fi scanning'; return; }
 for RADIO in $(sections wireless wifi-device); do say "$RADIO"; done
 ask "$(t 'Радиомодуль (0 назад):' 'Radio (0 back):')" || return; RADIO=$ANSWER
 ident "$RADIO" && [ "$(get wireless.$RADIO)" = wifi-device ] || return
 AP=
 for n in $(sections wireless wifi-iface); do
  [ "$(get wireless.$n.device)" = "$RADIO" ] || continue
  if [ "$(get wireless.$n.mode)" = sta ] && [ "$n" != owp_sta ]; then bad 'Existing STA on this radio; review manually'; return; fi
  if [ "$(get wireless.$n.mode)" = ap ] && [ "$(get wireless.$n.network)" = lan ]; then AP=$n; fi
 done
 [ -n "$AP" ] || { bad 'An existing AP on LAN is required'; return; }
 case "$(get wireless.$AP.encryption)" in psk2|sae|sae-mixed) :;; *) bad 'Secure personal WPA2/WPA3 LAN AP required'; return;; esac
 runtime=$(ubus call network.wireless status) || return
 device=$(printf '%s' "$runtime" | jsonfilter -e "@.$RADIO.interfaces[0].ifname")
 devname "$device" || { bad 'Enable this radio/AP before scanning'; return; }
 say "$(t 'Сканирование может ненадолго прервать Wi-Fi.' 'Scanning may briefly interrupt Wi-Fi.')"
 SCAN=$(ubus call iwinfo scan "{\"device\":\"$device\"}") || return
 ROW=0
 while [ "$ROW" -lt 64 ]; do
  found=$(row_value bssid); [ -n "$found" ] || break
  label=$(row_value ssid)
  if safe_text "$label"; then
   printf '%s) %s | %s | ch %s | %s dBm\n' "$((ROW + 1))" "$label" "$found" "$(row_value channel)" "$(row_value signal)"
  fi
  ROW=$((ROW + 1))
 done
 [ "$ROW" -gt 0 ] || { bad 'No networks found'; return; }
 ask "$(t 'Номер сети (0 назад):' 'Network number (0 back):')" || return; number=$ANSWER
 case "$number" in ''|*[!0-9]*|0) return;; esac
 [ "${#number}" -le 2 ] && [ "$number" -ge 1 ] && [ "$number" -le "$ROW" ] || return
 # Decimal conversion avoids shell octal arithmetic on input such as 08.
 ROW=$(awk -v n="$number" 'BEGIN{print n-1}')
 UP_SSID=$(row_value ssid); BSSID=$(row_value bssid); CHANNEL=$(row_value channel)
 safe_text "$UP_SSID" && [ "$(printf '%s' "$UP_SSID" | wc -c)" -le 32 ] && mac_valid "$BSSID" || return
 case "$CHANNEL" in ''|*[!0-9]*) return;; esac
 [ "$CHANNEL" -ge 1 ] && [ "$CHANNEL" -le 233 ] || return
 # Do not silently join open, WEP, WPA1 or enterprise networks.
 auth=$(row_value 'encryption.authentication[*]')
 versions=$(row_value 'encryption.wpa[*]')
 if printf '%s\n' "$auth" | grep -qx psk && printf '%s\n' "$versions" | grep -qx 2; then ENC=psk2
 elif printf '%s\n' "$auth" | grep -qx sae && printf '%s\n' "$versions" | grep -qx 3; then ENC=sae
 else bad 'Only WPA2/WPA3 Personal uplinks are supported'; return; fi
 secret "$(t 'Пароль основной сети:' 'Upstream Wi-Fi password:')" || return; UP_KEY=$ANSWER
 psk_valid "$UP_KEY" || { unset UP_KEY ANSWER; bad 'Use an 8-63 ASCII passphrase'; return; }
 LAN_ADDR=
 say "$(t 'Текущий LAN IP:' 'Current LAN IP:') $(get network.lan.ipaddr)"
 say "$(t '1 Сохранить LAN IP | 2 Выбрать другой LAN IP /24 | 0 Назад' '1 Keep LAN IP | 2 Choose another LAN IP /24 | 0 Back')"
 ask '>' || { unset UP_KEY ANSWER; return; }
 case "$ANSWER" in 1) :;; 2) choose_lan || { unset UP_KEY ANSWER; return; };; *) unset UP_KEY ANSWER; return;; esac
 say "$(t 'Создать повторитель? При конфликте подсетей или отказе DHCP настройки вернутся автоматически.' 'Create repeater? Subnet conflict or DHCP failure will restore previous settings automatically.')"
 say "$(t 'Отключите кабель WAN: проводной интернет имеет приоритет при обычной метрике. Сохраните кабель LAN для управления.' 'Unplug WAN: wired internet has priority at normal metrics. Keep a LAN cable for management.')"
 if repeater_stage; then
  unset UP_KEY ANSWER SCAN
  apply
 else unset UP_KEY ANSWER SCAN; fi
}
repair() {
