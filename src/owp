  [ ! -r "$BASE/repeater-result" ] || cat "$BASE/repeater-result"
  t '1 Состояние роутера' '1 Router status'
  t '2 Клиенты и привязки IP' '2 Clients and IP reservations'
  t '3 Интерфейсы и трафик' '3 Interfaces and traffic'
  printf '4 Wi-Fi\n'
  t '5 Диагностика сети' '5 Network diagnostics'
  t '6 Исправления и VPN' '6 Repairs and VPN'
