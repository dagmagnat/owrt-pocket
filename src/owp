#!/bin/sh
# owrt-pocket — MIT; OpenWrt BusyBox ash, no bash/python dependencies.
set -u
umask 077
VERSION=0.2.0
BASE=/etc/owrt-pocket
SELF=/usr/sbin/owp
CONFIG=/etc/config
TX=
LANGUAGE=ru
[ ! -r "$BASE/language" ] || read -r LANGUAGE < "$BASE/language"
R='' G='' Y='' B='' D='' Z=''
if [ -t 1 ] && [ "${TERM:-dumb}" != dumb ] && [ -z "${NO_COLOR:-}" ]; then
 R=$(printf '\033[91m'); G=$(printf '\033[92m'); Y=$(printf '\033[93m')
 B=$(printf '\033[96m'); D=$(printf '\033[1m'); Z=$(printf '\033[0m')
fi
t() { if [ "$LANGUAGE" = en ]; then printf '%s\n' "$2"; else printf '%s\n' "$1"; fi; }
say() { printf '%s%s%s\n' "$B" "$*" "$Z"; }
bad() { printf '%s%s%s\n' "$R" "$*" "$Z" >&2; }
ok() { printf '%s%s%s\n' "$G" "$*" "$Z"; }
ask() { printf '%s ' "$*"; IFS= read -r ANSWER || return 1; }
yes() { ask "$(t 'Для применения введите Yes:' 'Type Yes to apply:')" && [ "$ANSWER" = Yes ]; }
pause() { ask "$(t 'Enter — назад' 'Enter — back')" || :; }
need_root() { [ "$(id -u)" = 0 ] || { bad 'root required'; exit 1; }; }
ident() { case "$1" in ''|*[!a-zA-Z0-9_]* ) return 1;; esac; }
devname() { case "$1" in ''|*[!a-zA-Z0-9_.-]* ) return 1;; esac; }
mac_valid() { printf '%s\n' "$1" | grep -Eq '^([[:xdigit:]]{2}:){5}[[:xdigit:]]{2}$'; }
ipv4() { printf '%s\n' "$1" | awk -F. 'NF!=4{exit 1} {for(i=1;i<=4;i++) if($i!~/^[0-9]+$/||$i>255) exit 1}'; }
prefix_valid() { case "$1" in ''|*[!0-9]*) return 1;; esac; [ "${#1}" -le 2 ] && [ "$1" -le 32 ]; }
overlap() {
 ipv4 "$1" && prefix_valid "$2" && ipv4 "$3" && prefix_valid "$4" || return 2
 awk -v a="$1" -v p="$2" -v b="$3" -v q="$4" 'BEGIN {
  split(a,x,"."); split(b,y,"."); u=0;v=0
  for(i=1;i<=4;i++){u=u*256+x[i];v=v*256+y[i]}
  size=2^(32-(p<q?p:q)); exit int(u/size)!=int(v/size)
 }'
}
private_lan() {
 ipv4 "$1" || return 1
 printf '%s\n' "$1" | awk -F. '{exit !(($1==10 || ($1==172&&$2>=16&&$2<=31) || ($1==192&&$2==168)) && $4>=1 && $4<=254)}'
}
safe_text() { [ -n "$1" ] && ! printf '%s' "$1" | LC_ALL=C grep -q '[[:cntrl:]]'; }
psk_valid() { [ "${#1}" -ge 8 ] && [ "${#1}" -le 63 ] && ! printf '%s' "$1" | LC_ALL=C grep -q '[^ -~]'; }
row_value() { printf '%s' "$SCAN" | jsonfilter -e "@.results[$ROW].$1"; }
sections() { uci -q show "$1" | sed -n "s/^$1\.\([^.=]*\)=$2$/\1/p"; }
get() { uci -q get "$1" 2>/dev/null || :; }
stage() { uci -c "$TX/stage" -P "$TX/delta" "$@"; }
pending_id() { [ -r "$BASE/pending" ] && cat "$BASE/pending"; }
load_tx() {
 id=${1:-}; case "$id" in ''|*[!0-9_]* ) return 1;; esac
 TX=$BASE/transactions/$id
 [ -d "$TX/original" ] && [ "$(pending_id)" = "$id" ]
}
reload_all() {
 /etc/init.d/network reload
 wifi reload
 /etc/init.d/dnsmasq restart
 /etc/init.d/firewall reload
}
restore_files() {
 for f in network wireless dhcp firewall; do
  if [ -f "$TX/original/$f" ]; then cp -p "$TX/original/$f" "$CONFIG/$f" || return 1
  elif [ -f "$TX/absent-$f" ]; then rm -f "$CONFIG/$f"; fi
 done
}
rollback() {
 load_tx "$1" || return 1
 if [ "${2:-}" = boot ] && [ "$(cat "$TX/result" 2>/dev/null)" != confirmed ]; then rmdir "$TX/claim" 2>/dev/null || :; fi
 mkdir "$TX/claim" 2>/dev/null || return 1
 if restore_files; then
  printf 'rolled-back\n' > "$TX/result"
  rm -f "$BASE/pending"
  [ "${2:-}" = boot ] || reload_all
 else
  rmdir "$TX/claim"
  return 1
 fi
}
begin() {
 if [ -n "$(pending_id)" ]; then bad "$(t 'Сначала подтвердите или откатите предыдущее изменение.' 'Confirm or roll back the pending change first.')"; return 1; fi
 # Never overwrite another administrator's uncommitted UCI work.
 for f in network wireless dhcp firewall; do
  if [ -n "$(uci -q changes "$f")" ]; then bad "Uncommitted UCI: $f"; return 1; fi
 done
 count=$(find "$BASE/transactions" -mindepth 1 -maxdepth 1 -type d | wc -l)
 [ "$count" -lt 20 ] || { bad '20 backups retained. Archive/delete old transaction directories before continuing.'; return 1; }
 TX=$BASE/transactions/$(date +%s)_$$
 mkdir -p "$TX/original" "$TX/stage" "$TX/delta" || return 1
 for f in network wireless dhcp firewall; do
  if [ -f "$CONFIG/$f" ]; then
   cp -p "$CONFIG/$f" "$TX/original/$f" && cp -p "$CONFIG/$f" "$TX/stage/$f" || return 1
  else touch "$TX/absent-$f" "$TX/stage/$f"; fi
 done
}
apply() {
 for f in network wireless dhcp firewall; do stage commit "$f" || return 1; done
 for f in network wireless dhcp firewall; do
  if [ -f "$TX/original/$f" ]; then cmp -s "$TX/original/$f" "$CONFIG/$f" || { bad 'Configuration changed externally; retry'; return 1; }
  elif [ -e "$CONFIG/$f" ]; then bad 'Configuration changed externally; retry'; return 1; fi
 done
 say "$(t 'Изменение будет отменено через 120 с. Для сохранения: owp confirm' 'Rollback in 120s. To keep the change: owp confirm')"
 yes || return 1
 id=${TX##*/}
 printf '%s\n' "$id" > "$BASE/pending"
 nohup "$SELF" _apply "$id" </dev/null >"$TX/apply.log" 2>&1 &
 say "$(t 'Применение запущено. При потере SSH подключитесь снова.' 'Applying. Reconnect if SSH disconnects.')"
}
worker() {
 load_tx "$1" || exit 1
 nohup "$SELF" _watch "$1" </dev/null >"$TX/watch.log" 2>&1 &
 sleep 2
 for f in network wireless dhcp firewall; do
  cp -p "$TX/stage/$f" "$CONFIG/$f" || { rollback "$1"; exit 1; }
 done
 touch "$TX/applied"
 reload_all
 if [ -f "$TX/repeater" ]; then
  if repeater_verify; then touch "$TX/uplink-ready"
  else rollback "$1"; return 1; fi
 fi
 if load_tx "$1" && [ ! -d "$TX/claim" ] && [ -f "$TX/down-interface" ]; then
  read -r down < "$TX/down-interface"
  ident "$down" && ifdown "$down"
 fi
}
confirm() {
 id=$(pending_id); load_tx "$id" || { bad 'No pending change'; return 1; }
 [ -f "$TX/applied" ] || { bad 'Still applying'; return 1; }
 if [ -f "$TX/repeater" ] && [ ! -f "$TX/uplink-ready" ]; then
  bad "$(t 'Повторитель ещё проверяет DHCP и подсети. Подождите или прочтите owp repeater-status.' 'Repeater is checking DHCP/subnets. Wait or run owp repeater-status.')"; return 1
 fi
 say "$(t 'Проверьте LAN, Wi-Fi и интернет. Сохранить конфигурацию?' 'Check LAN, Wi-Fi and internet. Keep this configuration?')"
 yes || return 1
 mkdir "$TX/claim" 2>/dev/null || { bad 'Rollback already started'; return 1; }
 printf 'confirmed\n' > "$TX/result"
 rm -f "$BASE/pending"
 ok "$(t 'Сохранено' 'Saved')"
}
status() {
 say "$(t 'СОСТОЯНИЕ РОУТЕРА' 'ROUTER STATUS')"
 ubus call system board
 uptime
 free -m
 df -h /overlay /tmp 2>/dev/null
 say "$(t 'Адреса и маршруты' 'Addresses and routes')"
 ip -4 addr show
 ip -4 route show
 ip -6 route show default
 say "$(t 'Wi-Fi: фактическое состояние' 'Wi-Fi: runtime status')"
 ubus call network.wireless status | jsonfilter -e '@.*.up' | while read -r state; do
  if [ "$state" = true ]; then ok "$(t 'ВКЛЮЧЁН: ДА' 'ENABLED: YES')"; else bad "$(t 'ВКЛЮЧЁН: НЕТ' 'ENABLED: NO')"; fi
 done
}
interfaces() {
 for n in $(sections network interface); do
  say "$n  [$(get network.$n.proto)]  $(get network.$n.device)"
  data=$(ubus call "network.interface.$n" status 2>/dev/null) || continue
  up=$(printf '%s' "$data" | jsonfilter -e '@.up')
  if [ "$up" = true ]; then ok "$(t 'Подключён: ДА' 'Connected: YES')"; else bad "$(t 'Подключён: НЕТ' 'Connected: NO')"; fi
  printf '%s' "$data" | jsonfilter -e '@["ipv4-address"][*].address' -e '@["ipv6-address"][*].address'
 done
 say "$(t 'Счётчики RX/TX (байты, не скорость)' 'RX/TX counters (bytes, not speed)')"
 ip -s link
}
clients() {
 say "$(t 'DHCP-аренды (не доказательство присутствия)' 'DHCP leases (not proof of presence)')"
 [ ! -r /tmp/dhcp.leases ] || awk '{print $2, $3, $4}' /tmp/dhcp.leases
 say "$(t 'Соседи LAN' 'LAN neighbours')"; ip neigh show
 for obj in $(ubus list 'hostapd.*'); do
  say "$obj"; ubus call "$obj" get_clients
 done
 if command -v iw >/dev/null; then
  iw dev | awk '$1=="Interface"{print $2}' | while read -r dev; do
   say "$dev"; iw dev "$dev" station dump
  done
 fi
}
doctor() {
 say "$(t 'ДИАГНОСТИКА — без изменения настроек' 'DIAGNOSTICS — read only')"
 say "$(t 'LAN и физические порты' 'LAN and physical links')"
 ip -br addr 2>/dev/null || ip addr
 for path in /sys/class/net/*; do
  [ -e "$path/device" ] || [ -e "$path/phys_port_name" ] || continue
  printf '%s: ' "${path##*/}"; cat "$path/carrier" 2>/dev/null || :
 done
 if ip -4 route show default | grep -q .; then ok 'IPv4 default route: YES'; else bad 'IPv4 default route: NO'; fi
 gateway=$(ip -4 route show default | awk '/via/{print $3;exit}')
 if [ -n "$gateway" ]; then
  if ping -c 2 -W 2 "$gateway" >/dev/null 2>&1; then ok 'Gateway ICMP: YES'; else bad 'Gateway ICMP: NO / filtered'; fi
 fi
 INTERNET=0
 for target in 1.1.1.1 9.9.9.9; do
  if ping -c 2 -W 2 "$target" >/dev/null 2>&1; then ok "$target ICMP: YES"; INTERNET=1; else bad "$target ICMP: NO / filtered"; fi
 done
 if nslookup openwrt.org 127.0.0.1 >/dev/null 2>&1; then ok 'Local DNS: YES'; else bad 'Local DNS: NO'; fi
 say "$(t 'VPN/туннели и policy routing' 'VPN/tunnels and policy routing')"
 for n in $(sections network interface); do
  case "$(get network.$n.proto)" in wireguard|openvpn|tun|pptp|l2tp) say "$n: $(get network.$n.proto)";; esac
 done
 ip rule show; ip -4 route show table all
 for svc in openvpn pbr mwan3 sing-box xray tailscale; do
  [ ! -x "/etc/init.d/$svc" ] || { printf '%s: ' "$svc"; /etc/init.d/"$svc" status 2>/dev/null || :; }
 done
 say "$(t 'Последние сетевые сообщения (могут содержать адреса)' 'Recent network logs (may contain addresses)')"
 logread | grep -Ei 'netifd|dnsmasq|wan|wireguard|openvpn' | tail -n 25
 if [ "$INTERNET" = 0 ]; then
  say "$(t 'Проверьте кабель/PPPoE, DNS и VPN. ICMP может блокироваться — это не доказательство отсутствия интернета.' 'Check cable/PPPoE, DNS and VPN. ICMP may be filtered; failure does not prove internet is down.')"
 fi
 say "$(t 'Исправления: меню 6 — DNS/DHCP, WAN reconnect или временная остановка VPN. Выбирайте по результатам.' 'Repairs: menu 6 — DNS/DHCP, WAN reconnect or temporary VPN stop. Choose based on the findings.')"
}
lan_scan() {
 data=$(ubus call network.interface.lan status) || return
 addr=$(printf '%s' "$data" | jsonfilter -e '@["ipv4-address"][0].address')
 mask=$(printf '%s' "$data" | jsonfilter -e '@["ipv4-address"][0].mask')
 ipv4 "$addr" && [ "$mask" = 24 ] || { bad 'Active scan currently supports IPv4 LAN /24 only'; return; }
 prefix=${addr%.*}
 say "$(t 'Проверка ICMP до 32 адресов своей LAN. Спящие устройства и фильтры могут не отвечать.' 'ICMP scan of up to 32 addresses on your LAN. Sleeping devices and filters may not reply.')"
 ask "$prefix.X — $(t 'начальный X (1–254; 0 назад):' 'first X (1–254; 0 back):')" || return
 start=$ANSWER
 case "$start" in ''|*[!0-9]*|0) return;; esac
 [ "${#start}" -le 3 ] && [ "$start" -ge 1 ] && [ "$start" -le 254 ] || return
 finish=$((start + 31)); [ "$finish" -le 254 ] || finish=254
 say "$prefix.$start — $prefix.$finish (~32s)"
 yes || return
 i=$start
 while [ "$i" -le "$finish" ]; do
  if ping -c 1 -W 1 "$prefix.$i" >/dev/null 2>&1; then ok "$prefix.$i"; fi
  i=$((i + 1))
 done
 ip neigh show
}
wifi_menu() {
 say '1 Wi-Fi ON | 2 Wi-Fi OFF | 3 SSID / password | 0'
 ask '>' || return
 case "$ANSWER" in
  1|2)
   choice=$ANSWER; begin || return
   for n in $(sections wireless wifi-device); do stage set "wireless.$n.disabled=$((choice - 1))" || return; done
   say "$(t 'Wi-Fi изменится. SSH по Wi-Fi может оборваться.' 'Wi-Fi changes may disconnect SSH.')"; apply;;
  3)
   for n in $(sections wireless wifi-iface); do say "$n: $(get wireless.$n.ssid) [$(get wireless.$n.encryption)]"; done
   ask "$(t 'Секция Wi-Fi (0 назад):' 'Wi-Fi section (0 back):')" || return; n=$ANSWER
   [ "$n" != 0 ] || return
   [ "$(get wireless.$n)" = wifi-iface ] && [ "$(get wireless.$n.mode)" = ap ] || return
   case "$(get wireless.$n.encryption)" in psk2|sae|sae-mixed) :;; *) bad 'Only personal WPA2/WPA3 AP supported'; return;; esac
   ask 'SSID:' || return; ssid=$ANSWER
   [ -n "$ssid" ] && [ "$(printf '%s' "$ssid" | wc -c)" -le 32 ] || return
   secret "$(t 'Новый пароль (8–63 ASCII):' 'New password (8–63 ASCII):')" || return; key=$ANSWER
   [ "${#key}" -ge 8 ] && [ "${#key}" -le 63 ] && ! printf '%s' "$key" | LC_ALL=C grep -q '[^ -~]' || return
   begin || return
   stage set "wireless.$n.ssid=$ssid" && stage set "wireless.$n.key=$key" || return
   unset key ANSWER; apply;;
 esac
}
secret() {
 printf '%s ' "$1"; stty -echo || return 1
 IFS= read -r ANSWER; rc=$?
 stty echo; printf '\n'; return "$rc"
}
client_menu() {
 clients
 say "$(t '1 Привязать IPv4 к MAC | 2 Отключить Wi-Fi клиента на 60 с | 0 Назад' '1 Reserve IPv4 for MAC | 2 Disconnect Wi-Fi client for 60s | 0 Back')"
 ask '>' || return; action=$ANSWER
 case "$action" in 1|2) :;; *) return;; esac
 ask 'MAC:' || return; mac=$ANSWER; mac_valid "$mac" || return
 if [ "$action" = 1 ]; then
  ask 'IPv4:' || return; addr=$ANSWER; ipv4 "$addr" || return
  # Require an existing LAN lease; refuse arbitrary addresses/subnets/conflicts.
  awk -v m="$mac" -v a="$addr" 'tolower($2)==tolower(m)&&$3==a{found=1} END{exit !found}' /tmp/dhcp.leases || { bad 'Use the current DHCP lease address for this MAC'; return; }
  for n in $(sections dhcp host); do
   if [ "$(get dhcp.$n.ip)" = "$addr" ] || printf '%s' "$(get dhcp.$n.mac)" | grep -qiF "$mac"; then bad 'Reservation already exists; review in LuCI'; return; fi
  done
  begin || return
  n=$(stage add dhcp host) || return
  stage set "dhcp.$n.mac=$mac" && stage set "dhcp.$n.ip=$addr" || return
  apply
 else
  ubus list 'hostapd.*'
  ask 'hostapd object:' || return; obj=$ANSWER
  ubus list 'hostapd.*' | grep -qxF "$obj" || return
  say "$(t 'Возможно отключение вашего телефона. Автооткат конфигурации здесь не нужен: бан на 60 с.' 'Your phone may disconnect. This is a temporary 60s ban.')"
  yes || return
  ubus call "$obj" del_client "{\"addr\":\"$mac\",\"reason\":5,\"deauth\":true,\"ban_time\":60000}"
 fi
}
wan_setup() {
 say "$(t '1 Перенести WAN-порт | 2 PPPoE | 3 DHCP' '1 Move WAN port | 2 PPPoE | 3 DHCP')"
 say "$(t '4 Интернет через Wi-Fi / повторитель' '4 Wi-Fi internet / repeater')"
 say "$(t '5 Изменить LAN IP | 0 Назад' '5 Change LAN IP | 0 Back')"
 ask '>' || return; action=$ANSWER
 case "$action" in 1|2|3) :;; 4) repeater_setup; return;; 5) lan_setup; return;; *) return;; esac
 old=$(get network.wan.device)
 devname "$old" && [ -d "/sys/class/net/$old" ] || { bad 'Simple network.wan.device required'; return; }
 if [ "$action" = 1 ]; then
  [ -z "$(sections network switch)$(sections network bridge-vlan)" ] || { bad 'swconfig / bridge VLAN: manual review required'; return; }
  case "$old" in *.*|br-*|wg*|tun*) bad 'Complex WAN device: manual review required'; return;; esac
  say "$(t 'Только простой DSA: порт LAN будет удалён из br-lan и станет WAN.' 'Simple DSA only: selected LAN port leaves br-lan and becomes WAN.')"
  # Require DSA evidence, a single unfiltered LAN bridge and no extra references.
  [ -e "/sys/class/net/$old/dsa" ] || { bad 'DSA not detected'; return; }
  bridge=
  for n in $(sections network device); do
   if [ "$(get network.$n.name)" = br-lan ] && [ "$(get network.$n.type)" = bridge ]; then bridge=$n; fi
  done
  [ -n "$bridge" ] && [ "$(get network.lan.device)" = br-lan ] && [ "$(get network.$bridge.vlan_filtering)" != 1 ] || { bad 'Simple br-lan required'; return; }
  ports=$(get network.$bridge.ports); say "$ports"
  ask "$(t 'Новый WAN-порт (0 назад):' 'New WAN port (0 back):')" || return; port=$ANSWER
  devname "$port" && [ -e "/sys/class/net/$port/dsa" ] || return
  case " $ports " in *" $port "*) :;; *) return;; esac
  [ "$(printf '%s\n' "$ports" | wc -w)" -ge 2 ] || { bad 'At least one LAN port must remain'; return; }
  for n in $(sections network interface); do
   case "$(get network.$n.device)" in "$port"|"$port."*) bad 'Port already referenced'; return;; esac
  done
  for n in $(sections network device); do
   [ "$n" = "$bridge" ] && continue
   case " $(get network.$n.ports) " in *" $port "*) bad 'Port belongs to another bridge'; return;; esac
   [ "$(get network.$n.ifname)" != "$port" ] || { bad 'Port is referenced by another device'; return; }
  done
  [ -z "$(get network.wan6.device)" ] || [ "$(get network.wan6.device)" = '@wan' ] || [ "$(get network.wan6.device)" = "$old" ] || { bad 'Complex WAN6'; return; }
  say "$old -> $port; LAN: $ports -> remove $port"
  say "$(t 'После применения переставьте кабель провайдера. Порт станет внешним WAN с действующими правилами firewall.' 'Move the ISP cable after applying. Port becomes external WAN under existing firewall rules.')"
  begin || return
  stage del_list "network.$bridge.ports=$port" && stage set "network.wan.device=$port" || return
  if [ "$(get network.wan6.device)" = "$old" ]; then stage set "network.wan6.device=$port" || return; fi
 elif [ "$action" = 2 ]; then
  [ "$(get network.wan.proto)" = dhcp ] || [ "$(get network.wan.proto)" = pppoe ] || { bad 'Only existing DHCP/PPPoE WAN supported'; return; }
  command -v pppd >/dev/null && find /usr/lib/pppd -name '*pppoe*' 2>/dev/null | grep -q . || { bad 'Install ppp and ppp-mod-pppoe first'; return; }
  ask 'PPPoE login:' || return; user=$ANSWER; [ -n "$user" ] || return
  secret 'PPPoE password:' || return; pass=$ANSWER; [ -n "$pass" ] || return
  say "WAN: $old -> PPPoE; firewall: existing WAN zone"
  begin || return
  stage set network.wan.proto=pppoe && stage set network.wan.auto=1 && stage set network.wan.defaultroute=1 && stage set "network.wan.username=$user" && stage set "network.wan.password=$pass" || return
  disable_repeater || return
  unset pass ANSWER
 else
  [ "$(get network.wan.proto)" = dhcp ] || [ "$(get network.wan.proto)" = pppoe ] || { bad 'Only existing DHCP/PPPoE WAN supported'; return; }
  say "$(t 'WAN получит адрес, шлюз и DNS автоматически. Удалить PPPoE-реквизиты?' 'WAN will obtain address, gateway and DNS automatically. Remove PPPoE credentials?')"
  begin || return
  dhcp_stage || return
 fi
 # Existing WAN zone must cover wan, with masquerading and reject/drop input.
 zone=
 for n in $(sections firewall zone); do
  case " $(get firewall.$n.network) " in *' wan '*) zone=$n;; esac
 done
 [ -n "$zone" ] && [ "$(get firewall.$zone.masq)" = 1 ] || { bad 'Existing masqueraded WAN firewall zone required'; return; }
 case "$(get firewall.$zone.input)" in REJECT|DROP) :;; *) bad 'WAN input must be REJECT/DROP'; return;; esac
 apply
}
dhcp_stage() {
 stage set network.wan.proto=dhcp && stage set network.wan.auto=1 &&
 stage set network.wan.defaultroute=1 && stage set network.wan.peerdns=1 || return 1
 for option in username password service ac demand keepalive pppd_options dns; do stage -q delete "network.wan.$option" || :; done
 disable_repeater
}
disable_repeater() {
 if [ "$(get network.owp_wwan.owp_managed)" = 1 ]; then
  stage set network.owp_wwan.auto=0 && stage set wireless.owp_sta.disabled=1 || return 1
  printf 'owp_wwan\n' > "$TX/down-interface"
 fi
}
lan_settings() {
 [ "$(get network.lan.proto)" = static ] && [ "$(get dhcp.lan)" = dhcp ] && [ "$(get dhcp.lan.interface)" = lan ] || { bad 'Simple static LAN with dhcp.lan required'; return 1; }
 [ -z "$(sections dhcp host)$(get dhcp.lan.dhcp_option)" ] || { bad "$(t 'Сначала перенесите DHCP-резервации и пользовательские DHCP-опции в LuCI.' 'Migrate DHCP reservations/custom DHCP options in LuCI first.')"; return 1; }
 stage set "network.lan.ipaddr=$LAN_ADDR" && stage set network.lan.netmask=255.255.255.0 &&
 stage set dhcp.lan.ignore=0 && stage set dhcp.lan.start=100 && stage set dhcp.lan.limit=100
}
choose_lan() {
 say "$(t 'Выберите частный адрес роутера. Новая LAN будет /24, например 192.168.50.1.' 'Choose a private router address. New LAN is /24, e.g. 192.168.50.1.')"
 ask "$(t 'LAN IP (0 назад):' 'LAN IP (0 back):')" || return 1
 LAN_ADDR=$ANSWER
 private_lan "$LAN_ADDR" || { bad 'Invalid private /24 host address'; return 1; }
 # Keep the router outside the DHCP pool [100,199].
 octet=${LAN_ADDR##*.}
 [ "$octet" -lt 100 ] || [ "$octet" -gt 199 ] || { bad 'Router address must be outside DHCP pool .100-.199'; return 1; }
 for iface in $(sections network interface); do
  case "$iface" in lan|loopback) continue;; esac
  net=$(ubus call "network.interface.$iface" status 2>/dev/null) || continue
  count_addr=0
  while :; do
   other=$(printf '%s' "$net" | jsonfilter -e "@[\"ipv4-address\"][$count_addr].address")
   bits=$(printf '%s' "$net" | jsonfilter -e "@[\"ipv4-address\"][$count_addr].mask")
   [ -n "$other" ] || break
   if overlap "$LAN_ADDR" 24 "$other" "$bits"; then bad "$(t 'Пересечение с интерфейсом' 'Overlap with interface') $iface: $other/$bits"; return 1; fi
   count_addr=$((count_addr + 1))
  done
 done
 say "$(t 'После применения переподключите телефон с автоматическим DHCP. Новый SSH/LuCI адрес:' 'Reconnect your phone using automatic DHCP. New SSH/LuCI address:') $LAN_ADDR"
}
